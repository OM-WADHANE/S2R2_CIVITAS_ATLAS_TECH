#
# HOW TO USE THIS FILE
# ──────────────────────────────────────────────────────────────
# 1. Copy this file:   cp .env.example .env
# 2. Fill in every value marked  ← CHANGE THIS
# 3. Never commit the filled .env to Git (it is in .gitignore)
# ─────────────────────────────────────────────────────────────────


# ── Ownership Signature ───────────────────────────────────────
# DO NOT modify this value — the server will refuse to start if it
# doesn't match the expected HMAC computed from the brand constants.
OWNER_SIG=ab33e31dfa52e6d0087078fd205645d09832a8048cc09426c8e759bc8f131ad4


# ── Database (Neon PostgreSQL — Serverless) ───────────────────
# Get both URLs from: https://console.neon.tech
#   → Your project → Connection Details → toggle "Pooled" / "Direct"
#
# DATABASE_URL  → Connection Pooling URL  (used by the app at runtime)
# DIRECT_URL    → Direct connection URL   (used by Prisma migrations)
#
# ┌─────────────────────────────────────────────────────────────┐
# │  Neon URL format                                            │
# │  postgresql://<user>:<password>@<host>/<dbname>            │
# │           ?sslmode=require&channel_binding=require          │
# │                                                             │
# │  Pooler host ends in   -pooler.c-X.ap-...aws.neon.tech     │
# │  Direct  host ends in          .c-X.ap-...aws.neon.tech     │
# └─────────────────────────────────────────────────────────────┘

# Pooler (PgBouncer) — for all app queries
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.c-X.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# Direct — for prisma migrate deploy / prisma db push
DIRECT_URL="postgresql://USER:PASSWORD@HOST.c-X.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"


# ── Server ────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development          # change to production on Railway


# ── Security ──────────────────────────────────────────────────
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters"   # ← CHANGE THIS


# ── Frontend URL (CORS) ───────────────────────────────────────
# Local dev → http://localhost:3000
# Production (Vercel) → https://your-app.vercel.app
FRONTEND_URL="http://localhost:3000"                            # ← CHANGE THIS in production


# ── Groq AI (Decision Intelligence — Civi AI) ─────────────────
# Get a free key at: https://console.groq.com
# Leave blank to disable AI narrative (app still works without it)
GROQ_API_KEY=""                                                 # ← CHANGE THIS


# ── Trial / License ───────────────────────────────────────────
# Available license keys:
#   Civitas@admin0919  →  1-month plan   →  expires 2026-09-19
#   Civitas@admin0219  →  6-month plan   →  expires 2027-02-19
#   Civitas@admin0819  →  1-year plan    →  expires 2027-08-19
#
# To disable the trial gate entirely (fully licensed):
#   Set TRIAL_ENABLED=false  (omit TRIAL_LICENSE_KEY)
TRIAL_LICENSE_KEY=Civitas@admin0919                             # ← CHANGE THIS
# TRIAL_ENABLED=false                                           # uncomment for no-expiry


